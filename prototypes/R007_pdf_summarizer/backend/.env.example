# PDF Summarizer API Environment Configuration

# Application
APP_NAME=PDF Summarizer
APP_VERSION=1.0.0
PORT=8007
DEBUG=true

# Upload Configuration
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=16777216  # 16MB in bytes

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Summary Configuration (word limits)
SUMMARY_SHORT_MAX_WORDS=100
SUMMARY_MEDIUM_MAX_WORDS=300
SUMMARY_DETAILED_MAX_WORDS=600
