# =============================================================================
# R013 Travel Planning Stream - Environment Configuration
# =============================================================================

# Application
APP_NAME=R013_travel_planning_stream
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8013

# LLM (Ollama with gemma3:4b)
LLM_MODEL=ollama_chat/gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
ASYNC_MAX_WORKERS=4

# LLM Configuration Mode
# Options: "native" or "openai_compatible"
# native: Uses ollama_chat/* (may have Pydantic serialization warnings)
# openai_compatible: Uses openai/* with /v1 endpoint (bypasses LiteLLM Ollama adapter)
LLM_MODE=native

# OpenAI-compatible endpoint settings (when LLM_MODE=openai_compatible)
OLLAMA_OPENAI_MODEL=openai/gemma3:4b
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_OPENAI_API_KEY=ollama

# Search (SearXNG)
SEARXNG_URL=http://192.168.1.4:8080

# CORS
FRONTEND_URL=http://localhost:3000
