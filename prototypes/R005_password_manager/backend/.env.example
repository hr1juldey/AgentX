# Environment variables for Password Manager

# Application
APP_NAME=Password Manager
PORT=8005
DEBUG=true

# Security
# Generate a secure random key for production
SECRET_KEY=your-secret-key-change-in-production-use-environment-variable
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
# Generate a 32-byte key for encryption
ENCRYPTION_KEY=your-encryption-key-change-in-production-use-32-byte-key
