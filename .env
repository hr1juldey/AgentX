# AgentX Environment Configuration
# This file contains all configurable settings for Real AgentX v0.1
# Settings are loaded via Pydantic Settings (agentx/core/config.py)

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=AgentX
APP_VERSION=0.1.5
DEBUG=True

# =============================================================================
# Server Settings
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8015
SERVER_WORKERS=8
SERVER_LOG_LEVEL=info

# =============================================================================
# LLM Settings (Ollama)
# =============================================================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=16384

# =============================================================================
# Database Settings
# =============================================================================
# Redis (for caching and session storage) - AgentX uses port 6380 to avoid conflicts
DATABASE__REDIS_URL=redis://localhost:6380/0

# SQLite (for persistent storage)
DATABASE__SQLITE_PATH=data/agentx.db

# Qdrant (for vector storage/RAG) - AgentX uses port 6335 to avoid conflicts
DATABASE__QDRANT_URL=http://localhost:6335

# =============================================================================
# Voice Settings (C010 - External Kyutai Integration)
# =============================================================================
# Primary: External kyutai voice-server (ws://localhost:16000)
# Fallback: Internal Silero services (deprecated - will be removed Phase 3)
VOICE__USE_KYUTAI_EXTERNAL=true
VOICE__USE_VOICE_SDK=false

# Kyutai WebSocket URLs (SDK appends /stt and /tts to base URL)
VOICE__KYUTAI_STT_URL=ws://localhost:16000/api/v1/ws
VOICE__KYUTAI_TTS_URL=ws://localhost:16000/api/v1/ws

# Audio Settings
VOICE__STT_SAMPLE_RATE=16000
VOICE__TTS_SAMPLE_RATE=24000
VOICE__VAD_THRESHOLD=0.5

# =============================================================================
# SearXNG Search Engine Settings
# =============================================================================
SEARXNG__BASE_URL=http://192.168.1.4:8080
SEARXNG__TIMEOUT=30

# =============================================================================
# Memory Settings
# =============================================================================
MEMORY__DEFAULT_QUALITY_SCORE=0.8
MEMORY__DEFAULT_CONFIDENCE=0.7
MEMORY__DEFAULT_TTL_DAYS=30
MEMORY__HIGH_QUALITY_THRESHOLD=0.7
MEMORY__LOW_QUALITY_THRESHOLD=0.6

# Mem0AI (Persistent Memory with Ollama + Qdrant)
MEM0_QDRANT_HOST=localhost
MEM0_QDRANT_PORT=6335
MEM0_LLM_MODEL=qwen2.5-coder:7b
MEM0_EMBEDDER_MODEL=mxbai-embed-large:latest
MEM0_EMBEDDING_DIMS=1024

# =============================================================================
# Search Settings
# =============================================================================
SEARCH__MIN_SUCCESS_COUNT=2
SEARCH__MIN_RESULTS=3

# =============================================================================
# Session Settings
# =============================================================================
SESSION__TIMEOUT_SECONDS=1200
